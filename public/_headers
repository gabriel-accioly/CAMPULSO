/index
  Cache-Control: public, no-cache, must-revalidate

/index.html
  Cache-Control: public, no-cache, must-revalidate

/r02/
  Cache-Control: public, no-cache, must-revalidate

/r02/index.html
  Cache-Control: public, no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: public, no-cache, must-revalidate

/sw.js
  Cache-Control: public, no-cache, must-revalidate

/r02/sw.js
  Cache-Control: public, no-cache, must-revalidate

/r02/icons/icone-192.png
  Cache-Control: public, no-cache, must-revalidate

/r02/icons/icone-512.png
  Cache-Control: public, no-cache, must-revalidate

/THIRD_PARTY_NOTICES.txt
  Cache-Control: public, no-cache, must-revalidate

