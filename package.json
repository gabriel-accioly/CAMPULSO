{
  "name": "campulso-integracao-react-dexie-001",
  "private": true,
  "version": "1.0.0",
  "description": "Organização acadêmica e planejamento de estudos com persistência local e funcionamento offline.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "build:technical": "vite build --mode technical",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && vite build && node scripts/build-offline.mjs",
    "test": "vitest run",
    "test:indexeddb": "node tests/indexeddb-browser.mjs",
    "test:compat": "node tests/backup-compat.mjs",
    "test:r02": "node tests/functional-browser.mjs",
    "test:watch": "vitest",
    "manifest": "node tests/build-manifest.mjs",
    "test:offline": "node tests/offline-browser.mjs",
    "test:r02:legacy": "node tests/r02-browser.mjs",
    "test:functional": "node tests/functional-browser.mjs",
    "test:ui": "vitest run tests/ui.test.tsx",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "31.0.1",
    "playwright": "1.62.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "4.1.12"
  }
}
